# 复制本文件为同目录的 application-local.yml 后，再填写实际值。
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/zjk_picture
    username: "${MYSQL_USERNAME}"
    password: "${MYSQL_PASSWORD}"

cos:
  client:
    host: "${COS_HOST}"
    secretId: "${COS_SECRET_ID}"
    secretKey: "${COS_SECRET_KEY}"
    region: "${COS_REGION}"
    bucket: "${COS_BUCKET}"
